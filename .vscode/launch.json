    "version": "0.2.0",
    "configurations": [
        {
            "name": "Bazaar POS (localhost:8080)",
            "request": "launch",
            "type": "dart",
            "deviceId": "web-server",
            "args": [
                "--web-hostname", "localhost",
                "--web-port", "8080"
            ]
        },
        {
            "name": "flutter pos",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "flutter pos (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "flutter pos (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        }
    ]
}
